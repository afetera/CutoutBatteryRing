<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:id="@+id/color_preview"
            android:layout_width="match_parent"
            android:layout_height="76dp" />

        <TextView
            android:id="@+id/color_hex_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textSize="15sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="13sp"
            android:text="@string/picker_hue" />

        <SeekBar
            android:id="@+id/sb_hue"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:max="360" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:text="@string/picker_saturation" />

        <SeekBar
            android:id="@+id/sb_sat"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:max="100" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:text="@string/picker_value" />

        <SeekBar
            android:id="@+id/sb_val"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:max="100" />

        <EditText
            android:id="@+id/et_hex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/picker_hex_hint"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLength="9"
            android:fontFamily="monospace" />

    </LinearLayout>
</ScrollView>
