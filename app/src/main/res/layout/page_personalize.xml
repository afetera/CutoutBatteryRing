<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="96dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/tab_personalize"
            android:textSize="22sp"
            android:textStyle="bold" />

        <io.github.eta.cutoutring.RingPreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginTop="8dp" />

        <!-- 外观 -->
        <LinearLayout
            android:id="@+id/card_appearance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_appearance"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/sw_enable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/opt_enable" />

            <Switch
                android:id="@+id/sw_track"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/opt_track" />

            <io.github.eta.cutoutring.StepperView
                android:id="@+id/st_stroke"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />

            <io.github.eta.cutoutring.StepperView
                android:id="@+id/st_gap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />

            <io.github.eta.cutoutring.StepperView
                android:id="@+id/st_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />
        </LinearLayout>

        <!-- 颜色 -->
        <LinearLayout
            android:id="@+id/card_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_color"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_monet"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:textSize="12sp"
                    android:text="@string/mode_monet_short" />

                <RadioButton
                    android:id="@+id/rb_monet_gradient"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:textSize="12sp"
                    android:text="@string/mode_monet_gradient_short" />

                <RadioButton
                    android:id="@+id/rb_single"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:textSize="12sp"
                    android:text="@string/mode_single_short" />

                <RadioButton
                    android:id="@+id/rb_gradient"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:textSize="12sp"
                    android:text="@string/mode_gradient_short" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/row_monet_palette"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/monet_palette"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/monet_pair_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_single"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/color_single"
                    android:textSize="13sp" />

                <View
                    android:id="@+id/swatch_single"
                    android:layout_width="38dp"
                    android:layout_height="38dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_gradient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/color_start"
                        android:textSize="13sp" />

                    <View
                        android:id="@+id/swatch_start"
                        android:layout_width="38dp"
                        android:layout_height="38dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/color_end"
                        android:textSize="13sp" />

                    <View
                        android:id="@+id/swatch_end"
                        android:layout_width="38dp"
                        android:layout_height="38dp" />
                </LinearLayout>
            </LinearLayout>

            <Switch
                android:id="@+id/sw_warn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/warn_enable" />

            <io.github.eta.cutoutring.StepperView
                android:id="@+id/st_warn_threshold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <LinearLayout
                android:id="@+id/row_warn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/warn_color"
                    android:textSize="13sp" />

                <View
                    android:id="@+id/swatch_warn"
                    android:layout_width="38dp"
                    android:layout_height="38dp" />
            </LinearLayout>

            <Switch
                android:id="@+id/sw_charging"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/charging_override" />

            <LinearLayout
                android:id="@+id/row_charging"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/charging_color"
                    android:textSize="13sp" />

                <View
                    android:id="@+id/swatch_charging"
                    android:layout_width="38dp"
                    android:layout_height="38dp" />
            </LinearLayout>
        </LinearLayout>
        <!-- 充电功率内环 -->
        <LinearLayout
            android:id="@+id/card_power"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_power"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/sw_power"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/opt_power" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/power_hint"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/power_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/section_power_style"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_power_style"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="14dp"
                        android:paddingTop="6dp"
                        android:paddingRight="2dp"
                        android:paddingBottom="6dp"
                        android:text="@string/action_expand"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/power_style_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <RadioGroup
                        android:id="@+id/rg_power_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rb_power_follow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="13sp"
                            android:text="@string/power_mode_follow_short" />

                        <RadioButton
                            android:id="@+id/rb_power_single"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="13sp"
                            android:text="@string/power_mode_single_short" />

                        <RadioButton
                            android:id="@+id/rb_power_gradient"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="13sp"
                            android:text="@string/power_mode_gradient_short" />
                    </RadioGroup>

                    <LinearLayout
                        android:id="@+id/row_power_single"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/power_color"
                            android:textSize="13sp" />

                        <View
                            android:id="@+id/swatch_power"
                            android:layout_width="38dp"
                            android:layout_height="38dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/row_power_gradient"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/power_color_start"
                                android:textSize="13sp" />

                            <View
                                android:id="@+id/swatch_power_start"
                                android:layout_width="38dp"
                                android:layout_height="38dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/power_color_end"
                                android:textSize="13sp" />

                            <View
                                android:id="@+id/swatch_power_end"
                                android:layout_width="38dp"
                                android:layout_height="38dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <io.github.eta.cutoutring.StepperView
                        android:id="@+id/st_power_max"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />

                    <io.github.eta.cutoutring.StepperView
                        android:id="@+id/st_power_stroke"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 充电动画 -->
        <LinearLayout
            android:id="@+id/card_charge_anim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_charge_anim"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/sw_charge_anim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/opt_charge_anim" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/charge_anim_hint"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <io.github.eta.cutoutring.StepperView
                android:id="@+id/st_charge_anim_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
