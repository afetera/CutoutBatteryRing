<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/tab_personalize"
            android:textSize="22sp"
            android:textStyle="bold" />

        <io.github.eta.cutoutring.RingPreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="8dp" />

        <!-- 外观 -->
        <LinearLayout
            android:id="@+id/card_appearance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_appearance"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/sw_enable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/opt_enable" />

            <Switch
                android:id="@+id/sw_track"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/opt_track" />

            <io.github.eta.cutoutring.StepperView
                android:id="@+id/st_stroke"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />

            <io.github.eta.cutoutring.StepperView
                android:id="@+id/st_gap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />

            <io.github.eta.cutoutring.StepperView
                android:id="@+id/st_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />
        </LinearLayout>

        <!-- 颜色 -->
        <LinearLayout
            android:id="@+id/card_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_color"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_monet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_monet" />

                <RadioButton
                    android:id="@+id/rb_monet_gradient"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_monet_gradient" />

                <RadioButton
                    android:id="@+id/rb_single"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_single" />

                <RadioButton
                    android:id="@+id/rb_gradient"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_gradient" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/row_monet_palette"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/monet_palette"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/monet_pair_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_single"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/color_single"
                    android:textSize="13sp" />

                <View
                    android:id="@+id/swatch_single"
                    android:layout_width="38dp"
                    android:layout_height="38dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_gradient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/color_start"
                        android:textSize="13sp" />

                    <View
                        android:id="@+id/swatch_start"
                        android:layout_width="38dp"
                        android:layout_height="38dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/color_end"
                        android:textSize="13sp" />

                    <View
                        android:id="@+id/swatch_end"
                        android:layout_width="38dp"
                        android:layout_height="38dp" />
                </LinearLayout>
            </LinearLayout>

            <Switch
                android:id="@+id/sw_warn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/warn_enable" />

            <io.github.eta.cutoutring.StepperView
                android:id="@+id/st_warn_threshold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <LinearLayout
                android:id="@+id/row_warn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/warn_color"
                    android:textSize="13sp" />

                <View
                    android:id="@+id/swatch_warn"
                    android:layout_width="38dp"
                    android:layout_height="38dp" />
            </LinearLayout>

            <Switch
                android:id="@+id/sw_charging"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/charging_override" />

            <LinearLayout
                android:id="@+id/row_charging"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/charging_color"
                    android:textSize="13sp" />

                <View
                    android:id="@+id/swatch_charging"
                    android:layout_width="38dp"
                    android:layout_height="38dp" />
            </LinearLayout>
        </LinearLayout>
        <!-- 充电动画 -->
        <LinearLayout
            android:id="@+id/card_charge_anim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_charge_anim"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/sw_charge_anim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/opt_charge_anim" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/charge_anim_hint"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <io.github.eta.cutoutring.StepperView
                android:id="@+id/st_charge_anim_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
